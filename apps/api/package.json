{
  "name": "@rebound/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "dotenv -e ../../.env -- tsx watch src/index.ts",
    "start": "dotenv -e ../../.env -- tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "db:migrate": "dotenv -e ../../.env -- node-pg-migrate up",
    "db:migrate:down": "dotenv -e ../../.env -- node-pg-migrate down",
    "db:seed": "dotenv -e ../../.env -- tsx scripts/seed.ts",
    "db:setup": "pnpm run db:migrate && pnpm run db:seed",
    "check:rls": "dotenv -e ../../.env -- tsx scripts/check-rls.ts"
  },
  "dependencies": {
    "@google/genai": "2.19.0",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "node-pg-migrate": "9.0.0",
    "tsx": "4.23.13",
    "vitest": "4.1.11"
  }
}
