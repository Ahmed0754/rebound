# Supabase Postgres connection string.
# Dashboard -> Connect -> Transaction pooler (port 6543).
DATABASE_URL=""

GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.7-flash"

# API server. Deliberately not called PORT: dotenv-cli injects the root .env
# into every app, and Next.js would take PORT as its own and collide.
API_PORT="4000"
NEXT_PUBLIC_API_URL="http://localhost:4000"
