# Supabase Postgres connection string — privileged: owns the tables, bypasses
# RLS. Used by migrations, seed scripts, and admin tooling only.
# Dashboard -> Connect -> Transaction pooler (port 6543).
DATABASE_URL=""

# Restricted connection: subject to RLS, keyed on app.user_id per request via
# SET LOCAL. Role is created by migration 1756828800000; its password is set
# out-of-band, never committed — see apps/api/scripts/set-restricted-password.ts.
RESTRICTED_DATABASE_URL=""

GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.7-flash"

# API server. Deliberately not called PORT: dotenv-cli injects the root .env
# into every app, and Next.js would take PORT as its own and collide.
API_PORT="4000"
NEXT_PUBLIC_API_URL="http://localhost:4000"
